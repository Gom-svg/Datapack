# Compatibility sources and CLI goldens are byte-exact test inputs.
tests/fixtures/compatibility/*_source.* text eol=lf
tests/fixtures/compatibility/*.dpack -text
tests/golden/analyze/*.golden text eol=lf

# Release inputs must have identical bytes in Linux and Windows checkouts.
LICENSE-MIT text eol=lf
SECURITY.md text eol=lf
python/DATAPACK-LICENSE-MIT text eol=lf
docs/releases/*.md text eol=lf
Cargo.lock text eol=lf
python/Cargo.lock text eol=lf

# P8 candidate documents/lock and the tiny synthetic CRLF demo stay byte-stable.
desktop/Cargo.lock text eol=lf
desktop/README.md text eol=lf
desktop/app.manifest text eol=lf
tests/fixtures/desktop/demo.csv -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
